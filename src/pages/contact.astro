---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
const mapQuery = encodeURIComponent(`${site.address.lines.join(', ')}, ${site.address.postalCode} ${site.address.city}, ${site.address.country}`);
---
<Base title="Contact" description={`Contactez CSP Consulting à ${site.address.city} : ${site.phone.display}, ${site.email}.`}>
  <PageHero title="Contactez-nous" lead="Une question, un projet, une demande de formation ? Écrivez-nous ou appelez-nous." crumbs={[{ label: 'Contact' }]} />
  <section class="section">
    <div class="container contact">
      <aside class="contact__info">
        <h2>Nos coordonnées</h2>
        <dl>
          <div><dt><Icon name="map-pin" />Siège</dt><dd>{site.address.lines.map((l) => <>{l}<br /></>)}{site.address.postalCode} {site.address.city}, {site.address.country}<br /><a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} rel="noopener">Voir sur Google Maps</a></dd></div>
          <div><dt><Icon name="phone" />Téléphone</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          <div><dt><Icon name="mail" />E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt><Icon name="clock" />Horaires</dt><dd>{site.hours}</dd></div>
        </dl>
      </aside>
      <div class="contact__form">
        <h2>Envoyer un message</h2>
        <QuoteForm id="contact-form" />
      </div>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
  .contact__info { background: var(--paper-2); border-radius: var(--radius); padding: 1.75rem; }
  .contact__info h2, .contact__form h2 { font-size: var(--step-2); }
  dl { margin: 0; display: grid; gap: 1.25rem; }
  dt { font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }
  dt :global(svg) { width: 18px; height: 18px; color: var(--brand); }
  dd { margin: 0 0 0 1.6rem; }
</style>
