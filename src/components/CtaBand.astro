---
import { site } from '../data/site';
import { url } from '../lib/url';
interface Props { title?: string; text?: string }
const {
  title = 'Un projet, un audit ou une formation à prévoir ?',
  text = 'Décrivez-nous votre besoin : nous revenons vers vous avec une proposition adaptée.',
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn--cta" href={url('/devis')}>Demander un devis</a>
      <a class="btn btn--light" href={site.phone.href}>Appeler le {site.phone.display}</a>
    </div>
  </div>
</section>
<style>
  .cta-band { background: var(--ink); color: #dfe6ec; position: relative; }
  .cta-band::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--spectrum); }
  .cta-band__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 3rem; }
  .cta-band h2 { color: #fff; margin-bottom: 0.4rem; }
  .cta-band p { margin: 0; }
</style>
