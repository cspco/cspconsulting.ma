---
import { url } from '../lib/url';
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
const all = [{ label: 'Accueil', href: '/' }, ...items];
---
<nav aria-label="Fil d’Ariane" class="crumbs">
  <ol>
    {all.map((c, i) => (
      <li>{c.href && i < all.length - 1 ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; padding: 0; margin: 0 0 1.25rem; display: flex; flex-wrap: wrap; gap: 0.35rem; font-size: 0.92rem; }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: 0.35rem; opacity: 0.5; }
  .crumbs a { color: inherit; }
  .crumbs span { opacity: 0.75; }
</style>
