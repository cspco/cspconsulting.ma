---
import { Image } from 'astro:assets';
import type { Product } from '../data/catalog';
import { brands } from '../data/catalog';
import { url } from '../lib/url';
interface Props { p: Product }
const { p } = Astro.props;
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/products/*.jpg', { eager: true });
const img = imgs[`../assets/products/${p.image}`].default;
---
<a class="pcard" href={url(`/produits/${p.category}/${p.slug}`)} data-sub={p.subcategory}>
  <div class="pcard__img"><Image src={img} alt="" widths={[300, 600]} sizes="(max-width: 600px) 50vw, 280px" /></div>
  <div class="pcard__body">
    <span class="pcard__brand">{brands[p.brand] ?? p.brand}</span>
    <h3>{p.name}</h3>
  </div>
</a>
<style>
  .pcard { display: flex; flex-direction: column; text-decoration: none; color: inherit; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: border-color 0.15s, box-shadow 0.15s; }
  .pcard:hover { border-color: var(--brand); box-shadow: var(--shadow); }
  .pcard__img { aspect-ratio: 4 / 3; background: #fff; display: grid; place-items: center; padding: 1rem; border-bottom: 1px solid var(--line); }
  .pcard__img :global(img) { max-height: 100%; width: auto; object-fit: contain; }
  .pcard__body { padding: 1rem 1.1rem 1.2rem; }
  .pcard__brand { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--brand); }
  .pcard h3 { font-size: 1.05rem; margin: 0.3rem 0 0; line-height: 1.3; }
</style>
